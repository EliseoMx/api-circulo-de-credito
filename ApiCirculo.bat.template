@echo off
chcp 65001 >nul
cd /d "%~dp0"
REM ===========================================================================
REM Plantilla de ejemplo para correr ApiCirculo.exe, mismo estilo de flags que
REM BURO_DE_CREDITO.exe: /CLAVE_WS=valor
REM
REM COMO USARLA:
REM 1. Copia este archivo a dist\ApiCirculo.bat, junto al .exe compilado.
REM    dist\ esta en .gitignore, asi que esa copia con tus credenciales
REM    reales nunca se sube a GitHub. Esta plantilla se queda sin datos reales.
REM 2. Rellena API_KEY_WS, USUARIO_WS, PASS_WS y LLAVE_PRIVADA_WS con tus
REM    credenciales reales de Circulo de Credito.
REM 3. Quita el REM de la linea que quieras usar y ajusta los datos.
REM
REM /ArchivoSalida_WS controla que se genera: JSON, XML, PDF o ALL (los tres).
REM
REM IMPORTANTE - NUNCA pongas letras con acento o "n" con tilde (a, e, i, o,
REM u, n mayuscula o minuscula con tilde) en los valores de los flags dentro
REM de este .bat: un solo caracter asi rompe por completo como Windows lee
REM el archivo (deja de reconocer TODOS los comandos, incluso los de arriba).
REM Si la persona tiene acentos o "n" en su nombre o domicilio (lo normal en
REM espanol), usa /INPUT_WS="archivo.json" en vez de escribir los datos como
REM flags: el JSON si soporta acentos sin ningun problema.
REM ===========================================================================

REM Ejemplo 1: [ELIMINADO A PROPOSITO] La persona de prueba del sandbox
REM necesita "CIUDAD DE MEXICO" con acento para que el API la encuentre, y
REM ese acento no se puede escribir en ningun flag dentro de este .bat (ver
REM el aviso IMPORTANTE de arriba). Para probar en sandbox usa el Ejemplo 7
REM de abajo: no escribe ningun dato de persona, usa el que ya trae el
REM programa por dentro (ahi el acento si esta bien, porque vive en el
REM codigo Python, no en este .bat).

REM Ejemplo 2: produccion, persona pasada por flags (usa solo letras sin acento
REM ni "n" con tilde; si el nombre real las lleva, usa INPUT_WS con un .json).
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /Nombre_primerNombre_WS="..." /Nombre_apellidoPaterno_WS="..." /Nombre_apellidoMaterno_WS="..." /Nombre_RFC_WS="..." /Nombre_fechaNacimiento_WS="AAAA-MM-DD" /Domicilio_direccion1_WS="..." /Domicilio_colonia_WS="..." /Domicilio_municipio_WS="..." /Domicilio_ciudad_WS="..." /Domicilio_estado_WS="..." /Domicilio_CP_WS="..." /ArchivoSalida_WS="PDF"

REM Ejemplo 3a: produccion, un solo JSON de entrada, solo el XML. Esta es la
REM forma correcta de mandar personas con acentos o "n" en nombre/domicilio.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="XML"

REM Ejemplo 3b: produccion, varios JSON de un jalon usando *, todo: JSON+XML+PDF.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\*.json" /ArchivoSalida_WS="ALL"

REM Ejemplo 4: solo JSON (sin XML ni PDF), util si solo necesitas la respuesta cruda.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\*.json" /ArchivoSalida_WS="JSON"

REM Ejemplo 5: PDF de demo con identidad ficticia, para mostrar el formato sin exponer datos reales.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="PDF" /PDF_MASCARA_WS="SI"

REM Ejemplo 5b: el mismo PDF pero SIN mascara (PDF_MASCARA_WS="NO", el default), con los datos reales de la persona.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="PDF" /PDF_MASCARA_WS="NO"

REM Ejemplo 6: nombre de archivo elegido por ti (solo funciona con UNA persona). Tu pones "reportes\juan_perez", el programa agrega .json/.xml/.pdf.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="ALL" /NOMBRE_SALIDA_WS="reportes\juan_perez"

REM Ejemplo 7: DEV con tu API key ya colocada (dev solo necesita esa), persona de ejemplo automatica (no escribes ningun dato a mano), salida completa. La forma mas simple y segura de probar.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="dev" /API_KEY_WS="TU_API_KEY" /ArchivoSalida_WS="ALL"

REM Ejemplo 8: PRODUCCION completa, con las 4 credenciales colocadas, persona desde un .json (soporta acentos), salida completa (JSON+XML+PDF).
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="ALL"

REM Linea activa por default: sandbox con la persona de ejemplo, segura, los 3 archivos.
"%~dp0ApiCirculo.exe" /AMBIENTE_WS="dev" /ArchivoSalida_WS="ALL"
