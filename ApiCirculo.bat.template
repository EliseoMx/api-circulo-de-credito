@echo off
chcp 65001 >nul
cd /d "%~dp0"
REM ===========================================================================
REM Plantilla de ejemplo para correr ApiCirculo.exe, mismo estilo de flags que
REM BURO_DE_CREDITO.exe: /CLAVE_WS=valor
REM
REM COMO USARLA:
REM 1. Copia este archivo a dist\ApiCirculo.bat, junto al .exe compilado.
REM    dist\ esta en .gitignore, asi que esa copia con tus credenciales
REM    reales nunca se sube a GitHub. Esta plantilla se queda sin datos reales.
REM 2. Rellena API_KEY_WS, USUARIO_WS, PASS_WS y LLAVE_PRIVADA_WS con tus
REM    credenciales reales de Circulo de Credito.
REM 3. Quita el REM de la linea que quieras usar y ajusta los datos.
REM ===========================================================================

REM Ejemplo 1: sandbox, con la persona de prueba de siempre.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="dev" /API_KEY_WS="TU_API_KEY" /Nombre_primerNombre_WS="JUAN" /Nombre_apellidoPaterno_WS="SESENTAYDOS" /Nombre_apellidoMaterno_WS="PRUEBA" /Nombre_RFC_WS="SEPJ650809JG1" /Nombre_fechaNacimiento_WS="1965-08-09" /Domicilio_direccion1_WS="PASADISO ENCONTRADO 58" /Domicilio_colonia_WS="MONTEVIDEO" /Domicilio_municipio_WS="GUSTAVO A MADERO" /Domicilio_ciudad_WS="CIUDAD DE MEXICO" /Domicilio_estado_WS="CDMX" /Domicilio_CP_WS="07730" /ArchivoSalida_WS="JSON_Y_XML"

REM Ejemplo 2: produccion, persona pasada por flags.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /Nombre_primerNombre_WS="..." /Nombre_apellidoPaterno_WS="..." /Nombre_apellidoMaterno_WS="..." /Nombre_RFC_WS="..." /Nombre_fechaNacimiento_WS="AAAA-MM-DD" /Domicilio_direccion1_WS="..." /Domicilio_colonia_WS="..." /Domicilio_municipio_WS="..." /Domicilio_ciudad_WS="..." /Domicilio_estado_WS="..." /Domicilio_CP_WS="..." /ArchivoSalida_WS="JSON_Y_XML"

REM Ejemplo 3a: produccion, un solo JSON de entrada.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\persona.json" /ArchivoSalida_WS="JSON_Y_XML"

REM Ejemplo 3b: produccion, varios JSON de un jalon usando *.
REM "%~dp0ApiCirculo.exe" /AMBIENTE_WS="prod" /API_KEY_WS="TU_API_KEY" /USUARIO_WS="TU_USUARIO" /PASS_WS="TU_PASSWORD" /LLAVE_PRIVADA_WS="TU_LLAVE_PRIVADA_EN_HEX" /INPUT_WS="input\*.json" /ArchivoSalida_WS="JSON_Y_XML"

REM Linea activa por default: sandbox con la persona de ejemplo, segura.
"%~dp0ApiCirculo.exe" /AMBIENTE_WS="dev" /ArchivoSalida_WS="JSON_Y_XML"
